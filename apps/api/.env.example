# 로컬 개발용 키. 이 파일을 apps/api/.env 로 복사하면 Spring이 자동 로드한다.
# (.env 는 gitignore 됨. 값만 채우면 해당 기능이 바로 동작한다.)

# AI 콘텐츠 생성 (Anthropic Claude) — 없으면 /api/ai/generate 가 401/500
ANTHROPIC_API_KEY=

# ── 쇼핑쇼츠 생성 ─────────────────────────────────────────────────────────────
# 기본값은 비용 없는 로컬/Mock 조합이다. 실제 Claude/Kling 호출은 아래 live flag가 true일 때만 서버에서 허용한다.
# 실제 비용 테스트 전에는 필요한 줄만 주석 해제하고 서버를 재시작한다.
#
# [무료 전체 플로우 테스트] 기획/스토리보드/영상은 mock, TTS/렌더/품질은 로컬 산출물로 검증.
# SHOPPING_SHORTS_LIVE_API_ENABLED=false
# SHOPPING_SHORTS_PLANNING_PROVIDER=mock
# SHOPPING_SHORTS_STORYBOARD_PROVIDER=mock
# SHOPPING_SHORTS_VIDEO_PROVIDER=mock
# SHOPPING_SHORTS_TTS_PROVIDER=local-macos
# SHOPPING_SHORTS_RENDER_PROVIDER=local-ffmpeg
# SHOPPING_SHORTS_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# SHOPPING_SHORTS_FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# SHOPPING_SHORTS_FFMPEG_FONT_PATH=/System/Library/Fonts/AppleSDGothicNeo.ttc
# SHOPPING_SHORTS_TTS_SAY_PATH=/usr/bin/say
# SHOPPING_SHORTS_TTS_VOICE=
# SHOPPING_SHORTS_TTS_RATE=185
# SHOPPING_SHORTS_QUALITY_PROVIDER=local-file
#
# [실제 테스트 1단계: Claude 기획안만] ANTHROPIC_API_KEY를 재사용한다. Kling 영상은 계속 mock.
# SHOPPING_SHORTS_LIVE_API_ENABLED=true
# SHOPPING_SHORTS_PLANNING_PROVIDER=claude
# SHOPPING_SHORTS_STORYBOARD_PROVIDER=mock
# SHOPPING_SHORTS_VIDEO_PROVIDER=mock
# SHOPPING_SHORTS_TTS_PROVIDER=local-macos
# SHOPPING_SHORTS_RENDER_PROVIDER=local-ffmpeg
# SHOPPING_SHORTS_QUALITY_PROVIDER=local-file
#
# [실제 테스트 2단계: Claude 기획안 + Claude 스토리보드] Kling 영상은 계속 mock.
# SHOPPING_SHORTS_LIVE_API_ENABLED=true
# SHOPPING_SHORTS_PLANNING_PROVIDER=claude
# SHOPPING_SHORTS_STORYBOARD_PROVIDER=claude
# SHOPPING_SHORTS_VIDEO_PROVIDER=mock
# SHOPPING_SHORTS_TTS_PROVIDER=local-macos
# SHOPPING_SHORTS_RENDER_PROVIDER=local-ffmpeg
# SHOPPING_SHORTS_QUALITY_PROVIDER=local-file
#
# [실제 테스트 3단계: Kling 영상] 비용 발생 가능. 처음에는 mock 스토리보드로 AI 영상 씬 수를 제한한다.
# SHOPPING_SHORTS_LIVE_API_ENABLED=true
# SHOPPING_SHORTS_PLANNING_PROVIDER=mock
# SHOPPING_SHORTS_STORYBOARD_PROVIDER=mock
# SHOPPING_SHORTS_VIDEO_PROVIDER=kling
# SHOPPING_SHORTS_TTS_PROVIDER=local-macos
# SHOPPING_SHORTS_RENDER_PROVIDER=local-ffmpeg
# SHOPPING_SHORTS_QUALITY_PROVIDER=local-file
#
# [완전체 테스트: Claude 기획 + Claude 스토리보드 + Kling 영상 + OpenAI TTS + 로컬 렌더/검수]
# SHOPPING_SHORTS_LIVE_API_ENABLED=true
# SHOPPING_SHORTS_PLANNING_PROVIDER=claude
# SHOPPING_SHORTS_STORYBOARD_PROVIDER=claude
# SHOPPING_SHORTS_VIDEO_PROVIDER=kling
# SHOPPING_SHORTS_TTS_PROVIDER=openai
# SHOPPING_SHORTS_RENDER_PROVIDER=local-ffmpeg
# SHOPPING_SHORTS_QUALITY_PROVIDER=local-file
#
# Kling 단일 API 키 방식. Kling 콘솔에서 api-key-kling-... 형태로 보이는 값을 넣는다.
# KLING_API_KEY=
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL=kling-v2.1
# KLING_MODE=std
# KLING_TEXT_TO_VIDEO_PATH=/v1/videos/text2video
# KLING_IMAGE_TO_VIDEO_PATH=/v1/videos/image2video
# KLING_TEXT_TO_VIDEO_STATUS_PATH=/v1/videos/text2video/{taskId}
# KLING_IMAGE_TO_VIDEO_STATUS_PATH=/v1/videos/image2video/{taskId}
#
# Kling 구 Access/Secret 방식. 단일 API 키를 쓰면 아래 둘은 비워둔다.
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
#
# 쇼핑쇼츠 전용 Kling 키가 꼭 필요할 때만 사용한다. 설정 시 공용 KLING_*보다 우선된다.
# SHOPPING_SHORTS_KLING_API_KEY=
# SHOPPING_SHORTS_KLING_ACCESS_KEY=
# SHOPPING_SHORTS_KLING_SECRET_KEY=
# SHOPPING_SHORTS_KLING_BASE_URL=https://api-singapore.klingai.com
# SHOPPING_SHORTS_KLING_MODEL=kling-v2.1
# SHOPPING_SHORTS_KLING_MODE=std
# SHOPPING_SHORTS_OPENAI_API_KEY=
# SHOPPING_SHORTS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# SHOPPING_SHORTS_OPENAI_TTS_VOICE=verse

# Threads(메타) 연동 — OAuth/발행. (Threads 앱 ID/시크릿, FB 앱과 별개)
THREADS_APP_ID=
THREADS_APP_SECRET=
# 로컬 콜백/프론트 리다이렉트는 기본값 사용. 필요 시 오버라이드:
# THREADS_REDIRECT_URI=http://localhost:8080/api/threads/callback
# THREADS_FRONTEND_REDIRECT_URL=http://localhost:5173/settings/threads?threads=connected

# ── 로그인 = synub 통합계정(SSO). 제품은 SSO 발급 JWT를 검증만 한다. ──
# 로컬 기본값(application.yml)으로 동작: SSO_BASE_URL/JWKS=localhost:8090, audience=synub-postflow.
# 운영에서만 오버라이드:
# SSO_BASE_URL=https://accounts.synub.io
# SSO_JWKS_URI=https://accounts.synub.io/.well-known/jwks.json
# SSO_ISSUER=https://accounts.synub.io

# ── 구독 = synub 중앙 빌링. entitlements 조회 + 웹훅 수신. ──
# 로컬 기본값: BILLING_BASE_URL=localhost:8088, service-code=post-flow,
#   SERVICE_API_KEY=local-service-key, BILLING_WEBHOOK_SECRET=local-dev-webhook-secret.
# 운영에서만 오버라이드(빌링과 동일 값 공유):
# BILLING_BASE_URL=https://app.synub.io
# SERVICE_API_KEY=            # 빌링이 발급한 서비스 키(X-Service-Key)
# BILLING_WEBHOOK_SECRET=     # 빌링 app.webhook.secret 과 동일

# Threads OAuth state 서명(내부 전용, 로그인 아님) — 미설정 시 dev 기본값. prod 는 주입.
# AUTH_STATE_SECRET=

# Content ROI
# ROI_SHORT_LINK_BASE_URL=http://localhost:8080     # 단축링크(/r/{slug}) 베이스
# ROI_FRONTEND_BASE_URL=http://localhost:5173        # 리드 랜딩(/lp/{slug}) 베이스
# STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8080/files
# (전환 웹훅 HMAC은 사용자별 발급 — 전역 env 불필요)

# (선택) DB/Redis — 미설정 시 application-local.yml 기본값(localhost, postflow/postflow)
# DB_USERNAME=postflow
# DB_PASSWORD=postflow
